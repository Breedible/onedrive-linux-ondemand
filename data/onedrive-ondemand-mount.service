# Shows OneDrive in ~/OneDrive using rclone. Installed by `onedrive-ondemand setup`,
# which fills in the @...@ placeholders.
[Unit]
Description=OneDrive On-Demand: mount (rclone)
Documentation=https://github.com/Breedible/onedrive-linux-ondemand
After=network-online.target

[Service]
# rclone tells systemd when the mount is ready to use.
Type=notify
# Where Python finds our code.
Environment=PYTHONPATH=@SOURCE_DIR@
# Prepares ~/OneDrive, then becomes `rclone mount` (onedrive_ondemand/mount.py).
ExecStart=@PYTHON@ -m onedrive_ondemand mount
# Runs whenever rclone stops, even after a crash: clears a dead mount and
# makes the empty ~/OneDrive folder read-only again.
ExecStopPost=@PYTHON@ -m onedrive_ondemand mount-stopped
Restart=on-failure
RestartSec=10
# Give rclone time to unmount cleanly. Unfinished uploads resume next start.
TimeoutStopSec=60

[Install]
WantedBy=default.target
